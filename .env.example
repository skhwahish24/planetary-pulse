# Planetary Pulse — Environment Variables Template
# Copy this file to .env.local for local overrides.
# In Vercel, set these in Project Settings -> Environment Variables.

# Data Provider Mode: 'mock' (default, deterministic physical reanalysis) or 'live'
NEXT_PUBLIC_DATA_MODE=mock

# NASA FIRMS API Map Key for real-time active fire hotspots
# Get a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# NASA Earthdata Token for accessing ASF SAR granules and Earthdata Cloud datasets
# Free registration at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_TOKEN=

# Optional: External atmospheric and marine fallback keys
OPENWEATHER_API_KEY=
COPERNICUS_USER=
COPERNICUS_PASSWORD=
